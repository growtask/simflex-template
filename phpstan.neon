# Статический анализ шаблона и ядра: make phpstan (в Docker: docker compose exec app make phpstan)
parameters:
    level: 0
    paths:
        - Admin
        - Core
        - Extensions
        - provider
        - config.php
        - functions.php
        - public/index.php
        - sf
        - tests/Unit
        - tests/Acceptance
        - vendor/simflex/core/src
    excludePaths:
        - vendor/simflex/core/src/Admin/theme
    scanDirectories:
        - tests/Support
    tmpDir: cache/phpstan
    ignoreErrors:
        # new static() в фабричных методах: наследники не меняют сигнатуру конструктора
        - identifier: new.static
        # драйвер SMPP работает с необязательным пакетом glushkovds/php-smpp
        -
            identifier: class.notFound
            path: vendor/simflex/core/src/Sms/DriverSmpp.php
