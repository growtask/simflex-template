{
  "name": "growtask/simflex-template",
  "description": "Simflex CMS",
  "keywords": [
    "php",
    "simflex-admin",
    "simflex-cms",
    "simflex"
  ],
  "homepage": "https://github.com/growtask/simflex-template",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Denis Glushkov",
      "email": "amkarovec@gmail.com",
      "homepage": "https://github.com/glushkovds"
    },
    {
      "name": "pf",
      "homepage": "https://pff.su"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-gd": "*",
    "growtask/simflex-core": "4.0.x-dev",
    "ext-readline": "*",
    "growtask/simflex-file-manager": "dev-master",
    "ext-pdo": "*",
    "curl/curl": "^2.5"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.86",
    "codeception/module-phpbrowser": "*",
    "codeception/module-asserts": "*",
    "composer/composer": "*",
    "codeception/module-filesystem": "^3.0",
    "codeception/module-webdriver": "^4.0",
    "phpstan/phpstan": "^2.1"
  },
  "suggest": {
  },
  "scripts": {
    "post-create-project-cmd": [
      "@php -r \"foreach (['CHANGELOG.md', 'AGENTS.md', 'CLAUDE.md'] as \\$file) file_put_contents(\\$file, '');\""
    ],
    "post-package-install": [
      "App\\Extensions\\Install\\PackageInstaller::onPackageEvent"
    ],
    "post-package-update": [
      "App\\Extensions\\Install\\PackageInstaller::onPackageEvent"
    ],
    "post-install-cmd": [
      "php sf install/install",
      "./codecept run --steps"
    ],
    "post-update-cmd": [
      "php sf migrate/up"
    ]
  },
  "autoload": {
    "psr-4": {
      "App\\": ""
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
