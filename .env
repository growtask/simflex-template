# Database credentials.
DB_HOST=db
DB_USER=simflex
DB_PASS=simflex
DB_NAME=simflex

# Docker services started by `docker compose up -d`: dev - app, db, selenium (development and tests);
# on a server: empty - app only, cron - app and the cron scheduler. See docs, "Запуск на сервере".
COMPOSE_PROFILES=dev
# Docker: site port on the host (service app). Default: 480
# APP_PORT=8080

# Admin panel URL prefix. Default: /admin
# ADMIN_PATH=/cp

# Developer mode - disables some caching. Set to 0 if in production.
DEVELOPER=1
# Also write the log to log/YYYY-MM-DD.log (default: stdout only). Autotests read this file, so keep it on for them.
IS_LOG_TO_FILE=1
